---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import PhotoBg from './PhotoBg.astro';

/**
 * Footer bersama — dipakai di semua halaman publik.
 *
 * Struktur:
 * - Bagian atas : blok lokasi (peta ilustrasi + tombol Google Maps)
 * - Bagian bawah: logo+tagline, navigasi, ikon sosial, kontak
 *
 * Semua data berasal dari src/content/settings/site.json sehingga mudah
 * diperbarui dari dashboard CMS tanpa menyentuh kode.
 */
interface Props {
  logo?: string;
  siteName?: string;
  tagline?: string;
  city?: string;
  address?: string;
  hours?: string;
  whatsapp?: string;
  email?: string;
  instagram?: string;
  facebook?: string;
  tiktok?: string;
  mapLink?: string;
  background?: string;
}

const {
  logo,
  siteName = 'Kopi Kita Kita',
  tagline = 'Bebaskan Semuanya',
  city = 'Batam, Indonesia',
  address = '',
  hours = '',
  whatsapp = '',
  email = '',
  instagram = '',
  facebook = '',
  tiktok = '',
  mapLink = '',
  background = '',
} = Astro.props;

// Link peta: pakai link dari CMS; kalau kosong, pakai pencarian nama brand.
const mapsUrl =
  mapLink ||
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${siteName} ${city}`)}`;

const waNumber = whatsapp.replace(/[^\d]/g, '');
const waHref = waNumber ? `https://wa.me/${waNumber}` : '#';

const NAV = [
  { href: '/', label: 'Beranda' },
  { href: '/tentang-kami/', label: 'Tentang Kami' },
  { href: '/menu/', label: 'Menu' },
  { href: '/acara/', label: 'Acara' },
  { href: '/galeri/', label: 'Galeri' },
  { href: '/kontak/', label: 'Kontak' },
];

const SOCIALS = [
  { href: instagram, icon: 'instagram' as const, label: 'Instagram' },
  { href: facebook, icon: 'chat' as const, label: 'Facebook' },
  { href: tiktok, icon: 'music' as const, label: 'TikTok' },
].filter((s) => Boolean(s.href));
---

<!-- ===== Bagian atas: lokasi ===== -->
<section class="band taupe loc-band">
  <div class="wrap">
    <div class="loc">
      <div class="copy">
        <span class="eyebrow">Lokasi Kami</span>
        <h2>Temukan Kopi Kita Kita</h2>
        <p class="lead">
          Kami berada di {city}, mudah dijangkau dan terbuka untuk siapa saja yang ingin
          singgah.
        </p>
        {
          address && (
            <p class="addr">
              {address}
              <br />
              {city}
            </p>
          )
        }
        <div class="btn-row" style="margin-top:6px">
          <a
            class="btn"
            style="background:var(--roast)"
            target="_blank"
            rel="noopener noreferrer"
            href={mapsUrl}
          >
            Lihat di Google Maps
            <Icon name="external" size={17} />
          </a>
          <a class="btn ghost" href="/kontak/">Info kontak</a>
        </div>
      </div>

      <div class="map-wrap">
        <!--
          Peta ilustratif. Koordinat asli belum tersedia, jadi yang ditampilkan
          adalah ilustrasi wilayah Batam — bukan titik lokasi presisi.
          Begitu koordinat asli diisi di CMS, ganti blok ini dengan iframe
          Google Maps (lihat README, bagian "Mapa").
        -->
        <svg
          class="map"
          viewBox="0 0 520 340"
          role="img"
          aria-label="Ilustrasi wilayah Batam dengan penanda lokasi Kopi Kita Kita"
        >
          <g
            fill="none"
            stroke="#2a211b"
            stroke-width="1.4"
            stroke-linejoin="round"
            stroke-linecap="round"
          >
            <path
              d="M70 210c20-30 60-34 92-52 24-14 46-44 86-40 30 3 40 24 70 22 28-2 46-18 78-14 30 4 48 30 40 56-8 28-38 30-60 44-26 16-34 46-72 50-34 4-52-22-84-22-30 0-52 20-82 10-26-8-86-20-68-54Z"
            />
            <path
              d="M96 214c18-20 52-26 82-42 22-12 44-36 76-32 26 3 38 20 64 18 24-2 42-14 68-10"
              opacity=".55"
            />
            <path
              d="M120 236c26-10 50-6 80-18 24-10 40-26 70-24 22 1 36 12 60 10"
              opacity=".4"
            />
            <path
              d="M392 250c14-6 30-2 40 8 8 8 4 22-8 26-14 4-34-6-38-18-2-6 0-12 6-16Z"
            />
            <path d="M40 120c10-8 26-8 34 2 6 8 0 18-10 20-12 2-28-8-24-22Z" />
            <path d="M410 70c12-6 28-2 34 8 4 8-4 16-14 16-12 0-26-10-20-24Z" />
          </g>
          <g transform="translate(262 150)">
            <circle r="22" fill="#a8764a" opacity=".25" />
            <path
              d="M0 -26c-10 0-18 8-18 18 0 14 18 30 18 30s18-16 18-30c0-10-8-18-18-18Z"
              fill="#a8764a"
              stroke="#2a211b"
              stroke-width="1.4"
            />
            <circle cy="-8" r="6" fill="#f4ecdf" />
          </g>
          <text
            x="300"
            y="196"
            font-family="Barlow Condensed, Arial Narrow, sans-serif"
            font-size="30"
            font-weight="600"
            fill="#2a211b"
            letter-spacing="1">Batam</text
          >
        </svg>
        <div class="map-note">Ilustrasi wilayah, bukan titik lokasi presisi.</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== Bagian bawah: footer ===== -->
<footer class="foot">
  <div class="wrap foot-main">
    <div class="flogo">
      <a href="/" aria-label="Kopi Kita Kita, ke Beranda">
        <Logo src={logo} height={58} />
      </a>
      <p>{tagline}. {city}.</p>
    </div>

    <div>
      <h4>Navigasi</h4>
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h4>Ikuti Kami</h4>
      {
        SOCIALS.length > 0 ? (
          <div class="soc">
            {SOCIALS.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
              >
                <Icon name={s.icon} size={18} />
              </a>
            ))}
          </div>
        ) : (
          <p class="soc-note">Akun media sosial menyusul.</p>
        )
      }
    </div>

    <div>
      <h4>Kontak</h4>
      <ul class="ct">
        <li>
          <Icon name="chat" size={18} />
          <span>
            {
              whatsapp ? (
                <a href={waHref} target="_blank" rel="noopener noreferrer">
                  {whatsapp}
                </a>
              ) : (
                'Nomor WhatsApp menyusul'
              )
            }
          </span>
        </li>
        <li>
          <Icon name="mail" size={18} />
          <span>
            {
              email ? (
                <a href={`mailto:${email}`}>{email}</a>
              ) : (
                'Email menyusul'
              )
            }
          </span>
        </li>
        {hours && <li><Icon name="clock" size={18} /><span>{hours}</span></li>}
      </ul>
    </div>
  </div>

  <div class="foot-base">
    <div class="wrap">
      <span>&copy; {new Date().getFullYear()} {siteName}</span>
      <span>Bebaskan Semuanya</span>
    </div>
  </div>
</footer>

<style>
  /* ===== Blok lokasi ===== */
  .loc-band {
    background: var(--taupe);
    color: var(--roast);
  }

  .loc {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  .loc .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .addr {
    font-size: 0.95rem;
    border-left: 2px solid var(--roast);
    padding-left: 14px;
    color: #2f2822;
  }

  .map {
    width: 100%;
    height: auto;
    display: block;
  }

  .map-note {
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    color: #40382f;
    margin-top: 6px;
  }

  @media (max-width: 820px) {
    .loc {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ===== Footer ===== */
  .foot {
    background: var(--roast);
    color: var(--on-dark);
  }

  .foot-main {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.8fr) minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 32px;
    padding-block: 44px 36px;
  }

  .foot h4 {
    font: 600 0.74rem/1 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
    margin: 0 0 16px;
  }

  .foot ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .foot a {
    text-decoration: none;
    color: var(--on-dark);
    transition: color 0.2s;
  }

  .foot a:hover {
    color: var(--caramel-light);
  }

  .flogo a {
    display: inline-block;
    line-height: 0;
  }

  .flogo p {
    margin-top: 14px;
    color: var(--on-dark-soft);
    font-size: 0.9rem;
  }

  .soc {
    display: flex;
    gap: 10px;
  }

  .soc a {
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, background 0.2s;
  }

  .soc a:hover {
    border-color: var(--caramel);
    background: rgba(244, 236, 223, 0.06);
  }

  .soc-note {
    font-size: 0.88rem;
    color: var(--on-dark-soft);
  }

  .ct li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.92rem;
    color: var(--on-dark);
  }

  .ct li span {
    overflow-wrap: anywhere;
  }

  .foot-base {
    border-top: 1px solid var(--line-dark);
    font-size: 0.8rem;
    color: var(--on-dark-soft);
  }

  .foot-base .wrap {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 16px;
  }

  @media (max-width: 820px) {
    .foot-main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      padding-block: 34px 26px;
    }

    .foot-main > :first-child,
    .foot-main > :last-child {
      grid-column: 1 / -1;
    }
  }
</style>
