---
import Icon from './Icon.astro';

/**
 * Kartu acara (baris editorial) — dipakai di halaman Acara dan preview di Home.
 * Sumber data: koleksi `events` (hanya yang berstatus published).
 */
interface Props {
  title: string;
  description: string;
  date: string;
  time?: string;
  image?: string;
  location?: string;
  href?: string;
  isPast?: boolean;
  large?: boolean;
}

const {
  title,
  description,
  date,
  time,
  image,
  location,
  href,
  isPast = false,
  large = false,
} = Astro.props;

const d = new Date(`${date}T00:00:00`);
const day = d.getDate();
const month = d
  .toLocaleDateString('id-ID', { month: 'short' })
  .replace('.', '');
const year = d.getFullYear();

const fullDate = d.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class:list={['ev', { lg: large, past: isPast }]}>
  <div class="date">
    <b>{day}</b>
    <span>{month} {year}</span>
  </div>

  {large && (
    <div class="thumb">
      <div class="frame r32">
        {
          image ? (
            <img src={image} alt="" loading="lazy" decoding="async" />
          ) : (
            <div class="ph">
              <span class="ph-ic">
                <Icon name="calendar" size={28} />
              </span>
            </div>
          )
        }
      </div>
    </div>
  )}

  <div class="body">
    <h3>
      {href ? <a href={href}>{title}</a> : title}
      {isPast && <span class="tag">Selesai</span>}
    </h3>

    <div class="meta">
      <span>
        <Icon name="calendar" size={15} />
        <time datetime={date}>{fullDate}</time>
      </span>
      {time && (
        <span>
          <Icon name="clock" size={15} />
          {time}
        </span>
      )}
      {location && (
        <span>
          <Icon name="pin" size={15} />
          {location}
        </span>
      )}
    </div>

    <p>{description}</p>
  </div>

  {
    href && (
      <a class="btn ghost sm" href={href}>
        Lihat detail
        <Icon name="arrow" size={16} />
      </a>
    )
  }
</article>

<style>
  .ev {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) auto;
    gap: clamp(16px, 3vw, 32px);
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--line-light);
  }

  .ev:first-of-type {
    border-top: 1px solid var(--line-light);
  }

  .date {
    font-family: var(--font-head);
    line-height: 1;
    text-align: left;
  }

  .date b {
    display: block;
    font-size: 3.1rem;
    font-weight: 600;
  }

  .date span {
    font: 600 0.78rem/1.2 var(--font-body);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .body {
    min-width: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 0.88rem;
    color: var(--ink-soft);
    margin: 6px 0 8px;
  }

  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ev h3 {
    font-size: 1.7rem;
  }

  .ev h3 a {
    text-decoration: none;
  }

  .ev h3 a:hover {
    color: var(--caramel-deep);
  }

  .ev p {
    font-size: 0.97rem;
    color: var(--ink-soft);
  }

  .thumb {
    width: 132px;
    display: none;
  }

  .ev.lg {
    grid-template-columns: 200px 132px minmax(0, 1fr) auto;
  }

  .ev.lg .thumb {
    display: block;
  }

  .ev.past {
    opacity: 0.7;
  }

  @media (max-width: 820px) {
    .ev,
    .ev.lg {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .thumb,
    .ev.lg .thumb {
      display: block;
      width: 100%;
    }

    .date b {
      display: inline;
      font-size: 2.2rem;
      margin-right: 8px;
    }

    .date span {
      display: inline;
    }
  }
</style>
