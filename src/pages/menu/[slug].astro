---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('menu');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

interface Props {
  item: CollectionEntry<'menu'>;
}

const { item } = Astro.props;
const { name, description, details, price, image, category, available } = item.data;

const catLabel: Record<string, string> = {
  coffee: 'Coffee',
  'non-coffee': 'Non-Coffee',
  food: 'Food',
};
---

<PublicLayout title={name} description={description} current="/menu/">
  <section class="page-hero dark has-photo">
    <div class="hero-photo">
      {
        image ? (
          <img src={image} alt="" aria-hidden="true" loading="eager" decoding="async" />
        ) : (
          <div class="ph">
            <span class="ph-ic">
              <Icon name="coffee" size={34} />
            </span>
          </div>
        )
      }
    </div>
    <div class="overlay-grad" aria-hidden="true"></div>

    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/menu/">Menu</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{name}</span>
      </nav>
      <span class="eyebrow">{catLabel[category] ?? category}</span>
      <h1>{name}</h1>
      <p class="price">{price}</p>
    </div>
  </section>

  <section class="band cream">
    <div class="wrap">
      <div class="detail">
        <div class="detail-copy">
          <span class="eyebrow">Tentang produk</span>
          <h2>{name}</h2>
          <p class="lead">{description}</p>
          {details && <p>{details}</p>}

          {
            !available && (
              <p class="tag-note">Produk ini sedang tidak tersedia.</p>
            )
          }

          <div class="btn-row">
            <a class="btn ghost" href="/menu/">
              <Icon name="left" size={17} />
              Kembali ke Menu
            </a>
            <a class="btn" href="/kontak/">
              Tanya tentang produk ini
              <Icon name="arrow" size={18} />
            </a>
          </div>
        </div>

        <div class="detail-media">
          <div class="frame r43">
            {
              image ? (
                <img src={image} alt={name} loading="lazy" decoding="async" />
              ) : (
                <div class="ph">
                  <span class="ph-ic">
                    <Icon name="coffee" size={34} />
                  </span>
                  <span class="ph-cap">Foto belum tersedia</span>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .page-hero.has-photo {
    position: relative;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-photo :global(.ph) {
    min-height: 100%;
  }

  .overlay-grad {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(29, 22, 17, 0.92), rgba(29, 22, 17, 0.45));
  }

  .page-hero .wrap {
    position: relative;
    z-index: 2;
    padding-block: clamp(48px, 8vw, 96px);
  }

  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.85rem;
    color: var(--on-dark-soft);
    margin-bottom: 22px;
  }

  .crumbs a {
    color: var(--on-dark-soft);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--caramel-light);
  }

  .price {
    margin-top: 18px;
    font: 600 1.35rem/1 var(--font-body);
    color: var(--caramel-light);
    font-variant-numeric: tabular-nums;
  }

  .detail {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  .detail-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .detail-copy .eyebrow {
    margin: 0;
  }

  .tag-note {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .detail {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
