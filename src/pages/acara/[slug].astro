---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('events', ({ data }) => data.published);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

interface Props {
  item: CollectionEntry<'events'>;
}

const { item } = Astro.props;
const { title, description, date, time, image, location, externalLink } = item.data;

const d = new Date(`${date}T00:00:00`);
const fullDate = d.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const isPast = date < new Date().toISOString().slice(0, 10);
---

<PublicLayout title={title} description={description} current="/acara/">
  <section class="page-hero dark has-photo">
    <div class="hero-photo">
      {
        image ? (
          <img src={image} alt="" aria-hidden="true" loading="eager" decoding="async" />
        ) : (
          <div class="ph">
            <span class="ph-ic">
              <Icon name="calendar" size={34} />
            </span>
          </div>
        )
      }
    </div>
    <div class="overlay-grad" aria-hidden="true"></div>

    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/acara/">Acara</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>
      <span class="eyebrow">{isPast ? 'Acara Selesai' : 'Acara Mendatang'}</span>
      <h1>{title}</h1>
    </div>
  </section>

  <section class="band cream">
    <div class="wrap">
      <div class="detail">
        <div class="detail-copy">
          <span class="eyebrow">Detail Acara</span>
          <h2>{title}</h2>

          <ul class="meta-list">
            <li>
              <Icon name="calendar" size={18} />
              <span>
                <b>Tanggal</b>
                <time datetime={date}>{fullDate}</time>
              </span>
            </li>
            {
              time && (
                <li>
                  <Icon name="clock" size={18} />
                  <span>
                    <b>Waktu</b>
                    {time}
                  </span>
                </li>
              )
            }
            {
              location && (
                <li>
                  <Icon name="pin" size={18} />
                  <span>
                    <b>Lokasi</b>
                    {location}
                  </span>
                </li>
              )
            }
          </ul>

          <p class="lead">{description}</p>

          <div class="btn-row">
            {
              externalLink && (
                <a class="btn" href={externalLink} target="_blank" rel="noopener noreferrer">
                  Daftar / Info Lengkap
                  <Icon name="external" size={17} />
                </a>
              )
            }
            <a class="btn ghost" href="/acara/">
              <Icon name="left" size={17} />
              Semua Acara
            </a>
          </div>
        </div>

        <div class="detail-media">
          <div class="frame r43">
            {
              image ? (
                <img src={image} alt={title} loading="lazy" decoding="async" />
              ) : (
                <div class="ph">
                  <span class="ph-ic">
                    <Icon name="calendar" size={34} />
                  </span>
                  <span class="ph-cap">Foto belum tersedia</span>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .page-hero.has-photo {
    position: relative;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-photo :global(.ph) {
    min-height: 100%;
  }

  .overlay-grad {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(29, 22, 17, 0.92), rgba(29, 22, 17, 0.45));
  }

  .page-hero .wrap {
    position: relative;
    z-index: 2;
    padding-block: clamp(48px, 8vw, 96px);
  }

  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.85rem;
    color: var(--on-dark-soft);
    margin-bottom: 22px;
  }

  .crumbs a {
    color: var(--on-dark-soft);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--caramel-light);
  }

  .detail {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  .detail-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .detail-copy .eyebrow {
    margin: 0;
  }

  .meta-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    max-width: 380px;
  }

  .meta-list li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .meta-list li :global(svg) {
    margin-top: 3px;
    color: var(--caramel-deep);
  }

  .meta-list span {
    display: flex;
    flex-direction: column;
  }

  .meta-list b {
    font: 600 0.72rem/1 var(--font-body);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 4px;
  }

  @media (max-width: 820px) {
    .detail {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
