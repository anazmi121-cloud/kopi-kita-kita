---
import PublicLayout from '../layouts/PublicLayout.astro';
import GalleryItem from '../components/GalleryItem.astro';
import Icon from '../components/Icon.astro';
import { getGallery } from '../lib/data';

/**
 * Halaman Galeri — masonry responsif dengan lightbox yang aksesibel.
 * Lightbox: tombol tutup, panah navigasi, dan dukungan tombol Escape.
 */
const photos = await getGallery();
---

<PublicLayout
  title="Galeri"
  description="Galeri Kopi Kita Kita: interior, produk, suasana, dan dokumentasi acara."
  current="/galeri/"
>
  <section class="page-hero dark">
    <div class="wrap">
      <span class="eyebrow">Galeri</span>
      <h1>Potongan Kopi Kita Kita</h1>
      <p>
        Interior, produk, suasana, dan dokumentasi acara. Klik salah satu foto untuk
        melihat lebih dekat.
      </p>
    </div>
  </section>

  <section class="band cream">
    <div class="wrap">
      {
        photos.length > 0 ? (
          <div class="gal-grid" id="gal-grid">
            {photos.map((p, i) => (
              <GalleryItem
                src={p.data.src}
                alt={p.data.alt}
                caption={p.data.caption}
                index={i}
                ratio={i % 3 === 0 ? 'r43' : i % 3 === 1 ? 'r45' : 'r32'}
              />
            ))}
          </div>
        ) : (
          <div class="empty">
            <h3>Galeri masih kosong</h3>
            <p>Foto-foto Kopi Kita Kita akan ditambahkan di sini dari dashboard admin.</p>
            <a class="btn ghost" href="/kontak/">
              Hubungi Kami
              <Icon name="arrow" size={18} />
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- ===== Lightbox ===== -->
  <div class="overlay" id="lightbox" role="dialog" aria-modal="true" aria-label="Pratinjau foto">
    <button class="x" id="lb-close" type="button" aria-label="Tutup pratinjau foto">
      <Icon name="x" size={22} />
    </button>

    <button class="nav prev" id="lb-prev" type="button" aria-label="Foto sebelumnya">
      <Icon name="left" size={22} />
    </button>

    <button class="nav next" id="lb-next" type="button" aria-label="Foto berikutnya">
      <Icon name="right" size={22} />
    </button>

    <figure class="lb-figure">
      <div class="stage">
        <img id="lb-img" src="" alt="" />
      </div>
      <figcaption class="cap" id="lb-cap"></figcaption>
    </figure>
  </div>
</PublicLayout>

<style>
  .page-hero {
    background: var(--roast);
    color: var(--on-dark);
  }

  .page-hero .wrap {
    padding-block: clamp(48px, 8vw, 96px);
  }

  .page-hero h1 {
    max-width: 12ch;
  }

  .page-hero p {
    margin-top: 20px;
    max-width: 46ch;
    color: var(--on-dark-soft);
    font-size: 1.1rem;
  }

  /* Masonry */
  .gal-grid {
    columns: 3 220px;
    column-gap: 14px;
  }

  /* ===== Lightbox ===== */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(18, 13, 9, 0.86);
    display: none;
    align-items: center;
    justify-content: center;
    padding: max(16px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px))
      max(16px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
  }

  .overlay.open {
    display: flex;
  }

  .x {
    position: absolute;
    top: max(10px, env(safe-area-inset-top, 0px));
    right: max(10px, env(safe-area-inset-right, 0px));
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgba(29, 22, 17, 0.72);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .x:hover {
    background: rgba(29, 22, 17, 0.92);
  }

  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 0;
    background: rgba(29, 22, 17, 0.7);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav:hover {
    background: rgba(29, 22, 17, 0.92);
  }

  .prev {
    left: 10px;
  }

  .next {
    right: 10px;
  }

  .lb-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    color: var(--on-dark);
    max-width: 100%;
  }

  .stage {
    width: min(900px, 100%);
    max-height: 72vh;
    display: flex;
  }

  .stage img {
    max-width: 100%;
    max-height: 72vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2px;
  }

  .cap {
    font-size: 0.95rem;
    color: var(--on-dark-soft);
    text-align: center;
  }

  @media (max-width: 640px) {
    .nav {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  const overlay = document.getElementById('lightbox');
  const img = document.getElementById('lb-img') as HTMLImageElement | null;
  const cap = document.getElementById('lb-cap');
  const closeBtn = document.getElementById('lb-close');
  const prevBtn = document.getElementById('lb-prev');
  const nextBtn = document.getElementById('lb-next');
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-gal-src]')
  );

  let index = 0;
  let lastFocused: HTMLElement | null = null;

  function show(i: number) {
    if (buttons.length === 0) return;
    index = (i + buttons.length) % buttons.length;

    const btn = buttons[index];
    const src = btn.dataset.galSrc ?? '';
    const alt = btn.dataset.galAlt ?? '';
    const caption = btn.dataset.galCaption ?? '';

    if (img) {
      img.src = src;
      img.alt = alt;
    }
    if (cap) {
      cap.textContent = caption ? `${caption} — ${alt}` : alt;
    }
  }

  function open(i: number) {
    lastFocused = document.activeElement as HTMLElement;
    show(i);
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function close() {
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  buttons.forEach((btn, i) => btn.addEventListener('click', () => open(i)));

  closeBtn?.addEventListener('click', close);
  prevBtn?.addEventListener('click', () => show(index - 1));
  nextBtn?.addEventListener('click', () => show(index + 1));

  // Klik area gelap di luar foto menutup lightbox.
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  // Escape menutup; panah kiri/kanan berpindah foto.
  document.addEventListener('keydown', (e) => {
    if (!overlay?.classList.contains('open')) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      close();
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      show(index - 1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      show(index + 1);
    }
  });
</script>
