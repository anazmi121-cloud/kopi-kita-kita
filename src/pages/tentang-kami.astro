---
import PublicLayout from '../layouts/PublicLayout.astro';
import PhotoBg from '../components/PhotoBg.astro';
import Icon from '../components/Icon.astro';
import { loadSettings } from '../lib/data';

/**
 * Tentang Kami — layout editorial: teks dan foto berselang-seling.
 * Seluruh isi diambil dari settings (site.json) supaya mudah diperbarui lewat CMS.
 */
const settings = await loadSettings();

const aboutTitle = settings?.about?.title ?? 'Tempat Berhenti, Tempat Mulai';
const aboutSummary = settings?.about?.summary ?? '';
const aboutBody = settings?.about?.body ?? '';
const aboutBg = settings?.backgrounds?.about ?? '';
const heroBg = settings?.backgrounds?.hero ?? '';
---

<PublicLayout
  title="Tentang Kami"
  description={`Cerita, filosofi, dan nilai Kopi Kita Kita — coffee shop di Batam.`}
  current="/tentang-kami/"
>
  <!-- ============ Hero ============ -->
  <section class="page-hero dark has-photo">
    <PhotoBg src={heroBg} alt="" label="Kopi Kita Kita" />
    <div class="overlay-grad" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow">Tentang Kami</span>
      <h1>{aboutTitle}</h1>
      <p>{aboutSummary}</p>
    </div>
  </section>

  <!-- ============ Cerita ============ -->
  <section class="band cream">
    <div class="wrap">
      <div class="split">
        <div class="copy">
          <span class="eyebrow">Cerita Kami</span>
          <h2>Kenapa Kopi Kita Kita</h2>
          <p class="lead">{aboutSummary}</p>
          {aboutBody && <p>{aboutBody}</p>}
        </div>
        <div>
          <div class="frame r43">
            {
              aboutBg ? (
                <img src={aboutBg} alt="Interior Kopi Kita Kita" loading="lazy" decoding="async" />
              ) : (
                <div class="ph">
                  <span class="ph-ic">
                    <Icon name="image" size={34} />
                  </span>
                  <span class="ph-cap">Foto belum tersedia</span>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Nilai ============ -->
  <section class="band beige">
    <div class="wrap">
      <div class="values">
        <div class="copy">
          <span class="eyebrow">Filosofi</span>
          <h2>Nilai yang Kami Pegang</h2>
          <p class="lead">
            Tiga hal yang kami jaga supaya setiap kunjungan terasa sama baiknya dengan
            yang pertama.
          </p>
        </div>

        <ol>
          <li>
            <h3>Bebas</h3>
            <p>
              Kami buka ruang supaya Anda bisa datang apa adanya — tanpa aturan, tanpa
              beban untuk buru-buru.
            </p>
          </li>
          <li>
            <h3>Berkualitas</h3>
            <p>
              Biji kopi pilihan, susu segar, dan brewing yang teliti untuk setiap
              cangkir.
            </p>
          </li>
          <li>
            <h3>Hangat</h3>
            <p>
              Layanan yang 나서 dan tempat yang membuat orang betah lebih lama dari
              rencana semula.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ Pengalaman ============ -->
  <section class="band dark">
    <div class="wrap">
      <div class="journey">
        <div>
          <b>Ngopi Sendiri</b>
          <p>Menu lengkap dari kopi klasik sampai cangkik non-kopi favorit Anda.</p>
        </div>
        <div>
          <b>Duduk Lama</b>
          <p>Meja nyaman, Wi-Fi, dan lampu yang cukup untuk bekerja sampai larut.</p>
        </div>
        <div>
          <b>Bertemu Orang Baru</b>
          <p>Acara komunitas dan musik live yang kami rangkum agar ada alasan untuk datang lagi.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="band cream">
    <div class="wrap center">
      <span class="eyebrow">Lanjut</span>
      <h2>Mari Mampir</h2>
      <p class="lead">
        Lihat menu kami, atau cek agenda acara terdekat untuk jadwal lengkapnya.
      </p>
      <div class="btn-row center-row">
        <a class="btn" href="/menu/">
          Jelajahi Menu
          <Icon name="arrow" size={18} />
        </a>
        <a class="btn ghost" href="/kontak/">Lihat Kontak</a>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  .page-hero.has-photo {
    position: relative;
    overflow: hidden;
  }

  .page-hero.has-photo :global(.overlay-grad) {
    background: linear-gradient(90deg, rgba(29, 22, 17, 0.92), rgba(29, 22, 17, 0.45));
  }

  .page-hero .wrap {
    position: relative;
    z-index: 2;
    padding-block: clamp(48px, 8vw, 96px);
  }

  .page-hero h1 {
    max-width: 12ch;
  }

  .page-hero p {
    margin-top: 20px;
    max-width: 46ch;
    color: var(--on-dark-soft);
    font-size: 1.1rem;
  }

  /* Nilai */
  .values {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }

  .values .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .values ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
  }

  .values li {
    padding: 6px 24px;
    border-left: 1px solid var(--line-light);
  }

  .values li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .values h3 {
    font-size: 1.7rem;
    margin-bottom: 8px;
  }

  .values p {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  @media (max-width: 820px) {
    .values {
      grid-template-columns: minmax(0, 1fr);
    }

    .values ol {
      grid-template-columns: minmax(0, 1fr);
    }

    .values li {
      padding: 18px 0;
      border-left: 0;
      border-top: 1px solid var(--line-light);
    }

    .values li:first-child {
      border-top: 0;
    }
  }

  /* Pengalaman */
  .journey {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: 28px;
    border-top: 1px solid var(--line-dark);
  }

  .journey div {
    padding: 22px 24px 0 0;
  }

  .journey b {
    font: 600 0.78rem/1 var(--font-body);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--caramel-light);
    display: block;
    margin-bottom: 10px;
  }

  .journey p {
    font-size: 0.95rem;
    color: var(--on-dark-soft);
  }

  @media (max-width: 820px) {
    .journey {
      grid-template-columns: minmax(0, 1fr);
    }

    .journey div {
      padding: 18px 0;
    }
  }

  .center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .center-row {
    justify-content: center;
  }
</style>
